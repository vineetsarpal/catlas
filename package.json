{
  "name": "catlas-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:offline": "npm run build && python3 scripts/package-release.py",
    "release": "npm test && npm run package:offline && npm run test:offline",
    "test:offline": "python3 scripts/prepare-offline-test.py && playwright test --config playwright.offline.config.ts"
  },
  "dependencies": {
    "@meri-imperiumi/eccodes-wasm": "2.48.2",
    "d3-geo": "3.1.1",
    "dexie": "4.2.0",
    "maplibre-gl": "6.14.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
