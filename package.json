{
  "name": "catlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=@catlas/frontend --",
    "backend": "npm run dev --workspace=@catlas/backend --",
    "build": "npm run build --workspaces",
    "check": "npm run check --workspaces && tsc --noEmit -p tsconfig.json",
    "preview": "npm run preview --workspace=@catlas/frontend --",
    "test": "npm run test --workspaces",
    "test:frontend": "npm run test --workspace=@catlas/frontend --",
    "test:backend": "npm run test --workspace=@catlas/backend --",
    "check:backend": "npm run check --workspace=@catlas/backend",
    "test:e2e": "playwright test",
    "package:offline": "node scripts/build-offline.mjs && python3 scripts/package-release.py",
    "release": "npm test && npm run package:offline && npm run test:offline",
    "test:offline": "python3 scripts/prepare-offline-test.py && playwright test --config playwright.offline.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ]
}
