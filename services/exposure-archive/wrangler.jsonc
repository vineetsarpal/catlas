{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "catlas-exposure-proof",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "catlas-exposure-proof"
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "45001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "vars": {
    "MAX_GRID_BYTES": "33554432",
    "MAX_DETAIL_BYTES": "2097152",
    "MAX_DATABASE_BYTES": "100000000",
    "MAX_R2_BYTES": "384000000",
    "BACKUP_RESERVED_BYTES": "128000000",
    "MAX_CAPTURE_ATTEMPTS_PER_DAY": "100",
    "MAX_MAINTENANCE_REQUESTS_PER_DAY": "20"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CAPTURE_COORDINATOR",
        "class_name": "CaptureCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "cat45-capture-coordinator-v1",
      "new_sqlite_classes": [
        "CaptureCoordinator"
      ]
    }
  ]
}
