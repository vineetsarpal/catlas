# Copy to .env; never commit credentials.
CATLAS_API_PORT=3001
AISSTREAM_API_KEY=

# Free NASA FIRMS map key; fire detections unavailable without it.
FIRMS_MAP_KEY=

# VPS deployment uses a separate private ~/.config/catlas-monitor.env file.
# See docs/catlas-monitor-vps.md. Never put this token in frontend VITE_ settings.
